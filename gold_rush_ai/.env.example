# Chạy các lệnh từ thư mục gold_rush_ai để đường dẫn tương đối hoạt động.
# Sao chép thành .env; file .env được Git bỏ qua.
# Uvicorn: python -m uvicorn api.main:app --env-file .env
# Test/dashboard: dùng python -m dotenv -f .env run -- <lệnh>.
# config.py không tự đọc .env.

# Dùng model đã có, không huấn luyện hoặc ghi đè assets Flutter.
MO_HINH_DO_KHO=../gold_rush/assets/models/do_kho_v1.json
API_URL=http://127.0.0.1:8000
ENABLED=do_kho,tro_ly,ban_do,nhat_ky,vang
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173

# Để trống các biến trọng tài; không cần cấu hình blockchain để thử AI.
# TRONG_TAI_KHOA=
# HOP_DONG_CUA_HANG=
# CHAIN_ID=31337

# Ba API AI mới: thay dòng ENABLED ở trên khi cần chạy cùng backend.
# ENABLED=do_kho,tro_ly,ban_do,nhat_ky,vang,nhiem_vu,de_xuat_do_kho,nhan_vat_ai
# Demo offline tự cấu hình: python -B scripts/chay_demo_ai.py --kiem-tra
# Demo không phải xác thực; chỉ bật trên môi trường thử nghiệm cục bộ.
AI_QUEST_DEMO=false
AI_DIFFICULTY_DEMO=false
AI_IMAGE_DEMO=false
AI_QUEST_DB=data/nhiem_vu/quests.sqlite3
AI_IMAGE_DB=data/anh_nhan_vat/images.sqlite3
AI_IMAGE_TTL_SECONDS=86400
AI_IMAGE_MAX_IMAGES=200
AI_QUOTA_DB=data/quota_ai/quota.sqlite3
# Lượt gọi provider/người/ngày UTC; 0 chặn lượt mới, không chặn cache.
AI_IMAGE_DAILY_LIMIT=5
AI_QUEST_DAILY_LIMIT=20

# Provider nhiệm vụ: mặc định tắt; URL/model cần tương thích Chat Completions.
LLM_ENABLED=false
LLM_CHAT_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=10

# Provider ảnh: mặc định tắt; cấu hình Google Gemini (thế hệ mới: gemini-3.1-flash-image) hoặc custom HTTP:
# Lưu ý: Các model Imagen cũ (như imagen-3.0-generate-002) đã bị Google đóng từ tháng 8/2026.
# Chế độ 1: Offline Demo (mặc định không tốn phí, không gọi mạng)
# AI_IMAGE_ENABLED=false
# AI_IMAGE_DEMO=true

# Chế độ 2: Google Gemini Live (chủ động bật khi cần sinh ảnh AI thật)
# AI_IMAGE_ENABLED=true
# AI_IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# AI_IMAGE_TIMEOUT_SECONDS=20
# AI_IMAGE_FALLBACK_DEMO=false

# Cấu hình custom endpoint HTTP tương thích OpenAI Images (tùy chọn):
# AI_IMAGE_URL=
# AI_IMAGE_MODEL=
# AI_IMAGE_API_KEY=
# AI_IMAGE_TIMEOUT_SECONDS=10
