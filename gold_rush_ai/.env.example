# Chạy các lệnh từ thư mục gold_rush_ai để đường dẫn tương đối hoạt động.
# Sao chép thành .env; file .env được Git bỏ qua.
# Uvicorn: python -m uvicorn api.main:app --env-file .env
# Test/dashboard: dùng python -m dotenv -f .env run -- <lệnh>.
# config.py không tự đọc .env.

# Dùng model đã có, không huấn luyện hoặc ghi đè assets Flutter.
MO_HINH_DO_KHO=../gold_rush/assets/models/do_kho_v1.json
API_URL=http://127.0.0.1:8000
ENABLED=do_kho,tro_ly,ban_do,nhat_ky,vang
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174

# Để trống các biến trọng tài; không cần cấu hình blockchain để thử AI.
# TRONG_TAI_KHOA=
# HOP_DONG_CUA_HANG=
# HOP_DONG_VAT_PHAM=       # địa chỉ VatPhamGoldRush ERC-1155 transferable
# Local development (Hardhat):
# CHAIN_ID=31337
# AUTH_ALLOWED_CHAIN_IDS=31337
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
#
# APK/Release testnet (do not copy private keys into Flutter):
# CHAIN_ID=11155111
# AUTH_ALLOWED_CHAIN_IDS=11155111
# BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
# AUTH_SIWE_DOMAIN=app.example.com
# AUTH_SIWE_URI=https://app.example.com
# CORS_ORIGINS=https://app.example.com
# Faucet ETH giả chỉ dành cho Hardhat local; không bật trên Sepolia/mainnet.
# LOCAL_FAUCET_ENABLED=true
# LOCAL_FAUCET_AMOUNT_WEI=10000000000000000000000
# Sepolia Faucet (chỉ bật sau khi đã kiểm tra RPC, private key và số dư ví)
# SEPOLIA_FAUCET_ENABLED=false
# SEPOLIA_FAUCET_ADDRESS=0xa93BE13C54197457602437eC6EF9B8F7bA36B36A
# SEPOLIA_FAUCET_PRIVATE_KEY=
# SEPOLIA_FAUCET_LOW_BALANCE_ETH=0.001
# SEPOLIA_FAUCET_TARGET_BALANCE_ETH=0.003
# SEPOLIA_FAUCET_MAX_PER_WALLET_DAY_ETH=0.006
# SEPOLIA_FAUCET_MAX_TOTAL_DAY_ETH=0.05
# SEPOLIA_FAUCET_COOLDOWN_SECONDS=3600
# SEPOLIA_FAUCET_MAX_REQUESTS_PER_HOUR=3
# SEPOLIA_FAUCET_RECEIPT_TIMEOUT_SECONDS=30
# Phí gas giả quy đổi bằng vàng cho mỗi voucher; cọc hoàn lại không bị trừ.
# GAS_FEE_GOLD=2
# 0 = không giới hạn (chỉ nên dùng khi test Hardhat local).
# GOLD_DAILY_LIMIT=150

# Ba API AI mới: thay dòng ENABLED ở trên khi cần chạy cùng backend.
# ENABLED=do_kho,tro_ly,ban_do,nhat_ky,vang,nhiem_vu,de_xuat_do_kho,nhan_vat_ai
# Demo offline tự cấu hình: python -B scripts/chay_demo_ai.py --kiem-tra
# Demo không phải xác thực; chỉ bật trên môi trường thử nghiệm cục bộ.
AI_QUEST_DEMO=false
AI_DIFFICULTY_DEMO=false
AI_IMAGE_DEMO=false
AI_QUEST_DB=data/nhiem_vu/quests.sqlite3
AI_IMAGE_DB=data/anh_nhan_vat/images.sqlite3
AI_IMAGE_TTL_SECONDS=86400
AI_IMAGE_MAX_IMAGES=200
AI_QUOTA_DB=data/quota_ai/quota.sqlite3
# Lượt gọi provider/người/ngày UTC; 0 chặn lượt mới, không chặn cache.
AI_IMAGE_DAILY_LIMIT=5
AI_QUEST_DAILY_LIMIT=20

# Provider nhiệm vụ: mặc định tắt; URL/model cần tương thích Chat Completions.
LLM_ENABLED=false
LLM_CHAT_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=10

# Provider ảnh: mặc định tắt; cấu hình live bằng PixelLab.
# Chế độ 1: Offline Demo (mặc định không tốn phí, không gọi mạng)
# AI_IMAGE_ENABLED=false
# AI_IMAGE_DEMO=true

# Chế độ 2: PixelLab Live (chỉ đặt bí mật trong backend/.env)
# AI_IMAGE_ENABLED=true
# AI_IMAGE_PROVIDER=pixellab
# PIXELLAB_API_TOKEN=YOUR_PIXEL_LAB_API_TOKEN
# PIXELLAB_IMAGE_MODEL=create-character-with-4-directions
# PIXELLAB_BASE_URL=https://api.pixellab.ai/v2
# PIXELLAB_TIMEOUT_SECONDS=60
# PIXELLAB_POLL_INTERVAL_SECONDS=3
# PIXELLAB_MAX_POLLS=60
# AI_IMAGE_TIMEOUT_SECONDS=60
# AI_IMAGE_FALLBACK_DEMO=false
