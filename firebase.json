{
  "hosting": {
    "public": "gold_rush/build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/admin",
        "destination": "https://gold-rush-api.onrender.com/admin",
        "type": 302
      },
      {
        "source": "/admin/**",
        "destination": "https://gold-rush-api.onrender.com/admin",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
